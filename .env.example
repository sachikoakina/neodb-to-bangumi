# ═══════════════════════════════════════════════════════════════════════
#  neodb-to-bangumi — 全部配置
#
#  复制本文件为 `.env` 并填空。`.env` 已被 git 忽略，绝不提交真实凭据。
# ═══════════════════════════════════════════════════════════════════════

# ─── NeoDB（数据源，只读）───────────────────────────────────────────────
# 获取方式：登录实例 → /developer/ → 授权。
NEODB_API_TOKEN=
# 自建实例时指向你的实例。
# NEODB_BASE_URL=https://neodb.social
# 书架请求间隔，毫秒。
# NEODB_REQUEST_DELAY_MS=300
# 每个书架遍历的最大页数（安全上限；FULL_SYNC=1 时忽略）。
# NEODB_MAX_PAGES=10

# ─── Bangumi（写入目标）─────────────────────────────────────────────────
# 获取方式：https://next.bgm.tv/demo/access-token
BANGUMI_ACCESS_TOKEN=
# Bangumi 要求可识别的 UA 与真实链接。
# BANGUMI_USER_AGENT=neodb-to-bangumi/1.0 (+https://github.com/sachikoakina/neodb-to-bangumi)
# Bangumi 请求间隔，毫秒。
# BANGUMI_REQUEST_DELAY_MS=400

# ─── 同步行为 ───────────────────────────────────────────────────────────
# 1 = 只计算并打印计划，不写入任何数据。首次运行务必先 dry-run。
# SYNC_DRY_RUN=0
# 单次运行处理的条目上限；增量跳过的条目不消耗该预算，保证定时任务能持续推进。
# 注意 0 不是「无限」——低于 1 回落为 50。
# SYNC_MAX_ITEMS=50
# 要遍历的 NeoDB 书架（逗号分隔）。
# SYNC_SHELF_TYPES=wishlist,progress,complete,dropped
# 分类白名单（逗号分隔）：book,movie,tv,music,game,podcast,performance。
# podcast/performance 在 Bangumi 无对应类型，写入侧会被跳过。
# 写错分类名会让白名单整体作废（失败在关闭一侧），本次不同步任何分类。
# SYNC_CATEGORIES=book,movie,tv,music,game
# 标题匹配时允许的年份差（动画 2 / 真人 6 / 书籍 1 / 音乐 3 / 游戏 4 参与）。
# SYNC_YEAR_TOLERANCE=1
# 书籍类（type 1）单独的年份容差：初版/再版年份口径差异大，可放宽。
# SYNC_YEAR_TOLERANCE_BOOK=1
# 匹配严格模式（默认 1）：唯一同名候选若年份无法核对且平台形态不可判定，
# 不自动写入，转待核对名单——宁可漏配，不可错配。0 = 证据缺失照写（旧行为）。
# SYNC_MATCH_STRICT=1

# 评分合并：bangumi_prefer = 保留目标非 0 分（默认）；overwrite = 用 NeoDB 分覆盖。
# SYNC_NEODB_BANGUMI_RATING=bangumi_prefer
# 短评合并：bangumi_prefer = 保留目标非空短评（默认）；overwrite = 用 NeoDB 短评覆盖（空值会清空目标）。
# SYNC_NEODB_BANGUMI_COMMENT=bangumi_prefer
# 状态保护：off（默认）= 来源状态照写；no-downgrade = 现有「看过」保持不变，
# 评分/短评/隐私照常合并（只保护状态字段，不整条跳过）。
# SYNC_STATUS_GUARD=off
# 隐私模式：target（默认）= 统一写 SYNC_BANGUMI_PRIVATE；
# source = 逐条跟随 NeoDB visibility（2→私密，0/1→公开），源缺失保留目标现值。
# SYNC_BANGUMI_PRIVATE_MODE=target
# target 模式使用的 private 值；source 模式作为源缺失且无目标值时的兜底。
# SYNC_BANGUMI_PRIVATE=false

# 进度拉满总开关，默认关闭；1 时对 complete 条目执行：
#   书籍   → ep_status/vol_status 拉满至 eps/volumes 总量（总量缺失的维度跳过）
#   电影   → 补第一个正片集
#   TV/动画/真人 → 逐集标记看过；已是「看过」的集零请求
#   音乐/游戏 → 不写（平台无对应字段）
# 收藏字段无变化时仍会检查分集；分集读取/写入失败记 failed 并下一轮重试。
# SYNC_PROGRESS=0
# TV/动画/真人是否把 SP 纳入拉满范围；电影永不处理 SP。
# SYNC_INCLUDE_SP=0
# 是否把 OP/ED（type 2/3）也纳入拉满；默认关闭——看完本篇不代表看过主题曲。
# SYNC_INCLUDE_OP_ED=0

# 增量模式：按条目指纹跳过已同步项。FULL_SYNC=1 时自动关闭。
# SYNC_INCREMENTAL=1
# 增量指纹存储路径；删除文件即重新全量比对。
# SYNC_STATE_FILE=.cache/sync-state.json
# 全量模式：忽略 SYNC_MAX_ITEMS / NEODB_MAX_PAGES，关闭增量跳过。首次迁移用。
# FULL_SYNC=0
# 全量游标：仅 FULL_SYNC=1 使用，按书架记录下一页；空页或走完自动删除该书架键。
# 常规运行永远从第 1 页开始，不读也不写本文件。
# FULL_SYNC_CURSOR_FILE=.cache/full-sync-cursor.json

# ─── 产物 ───────────────────────────────────────────────────────────────
# 未匹配条目日志（upsert 去重，供人工核对补外链）。CI 中跨轮恢复并发布为
# review-state-*-stock artifact（保留 90 天）。dry-run 下写入派生文件
# unmatched-dryrun.json，不影响正式名单。
# SYNC_UNMATCHED_LOG=.cache/unmatched.json
# 匹配审计：每条进入处理的条目记录 匹配方式/候选/证据/结局（dry-run 也产出）。
# 错配复核与清理清单都以它为依据，随 review-state artifact 长期保留。
# SYNC_MATCH_AUDIT_FILE=.cache/match-audit.json
# 待核对名单按 lastSeenAt 老化的天数；默认 30，0 表示永不清理。
# 只按时间清理，不按「本轮未出现」淘汰——单链路没有 coverage 对账，按轮次删会误删缺口。
# REVIEW_STATE_MAX_AGE_DAYS=30
# 机器可读运行报告。
# SYNC_REPORT_FILE=.cache/sync-report.json
# Markdown 运行摘要。
# SYNC_SUMMARY_FILE=.cache/sync-summary.md
